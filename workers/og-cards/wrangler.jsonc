{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ccdexplorer-og-cards",
	"main": "src/entry.py",
	// Pinned rather than "today": the compatibility date selects the Pyodide
	// build, so moving it is a runtime upgrade and belongs in its own commit.
	"compatibility_date": "2025-11-02",
	"compatibility_flags": [
		"python_workers"
	],
	// Optional. Without it every crawler hit becomes an API request -- which
	// works, and is exactly what this is here to avoid.
	"kv_namespaces": [
		{
			"binding": "OG_CACHE",
			"id": "<CREATE WITH: wrangler kv namespace create OG_CACHE>"
		}
	],
	"vars": {
		"API_URL": "https://api.ccdexplorer.io"
	},
	// Uncomment once og.ccdexplorer.io exists, so the card URLs in the site
	// templates are on our own domain rather than workers.dev.
	// "routes": [
	// 	{ "pattern": "og.ccdexplorer.io/*", "zone_name": "ccdexplorer.io" }
	// ],
	"observability": {
		"enabled": true
	}
}
